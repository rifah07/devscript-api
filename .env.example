# ── Required ─────────────────────────────────────────────────────────────
NODE_ENV=development
MONGODB_URI=
MONGODB_DB=devscript_local   # unset in production (uses "devscript")
# Two DIFFERENT values, 32+ chars each:  openssl rand -hex 32
JWT_SECRET=
REFRESH_TOKEN_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# The two frontends (dev ports below; real URLs in production)
DEVSCRIPT_URL=http://localhost:3001
MISK_JOURNAL_URL=http://localhost:3002

# ── Recommended ──────────────────────────────────────────────────────────
# 32+ chars, SAME value in both frontends. Lets them rate-limit per reader.
INTERNAL_API_KEY=
# 16+ chars. Vercel Cron / cron-job.org send it as "Authorization: Bearer <value>"
CRON_SECRET=
# Email via Resend (free). Without a verified domain it delivers only to your
# own Resend address. Empty = emails are printed to the console (local dev).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=DevScript

# ── Optional ─────────────────────────────────────────────────────────────
PORT=3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Model ids (defaults are free-tier models as of Oct 2026)
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Safety net: max AI calls per server instance per day
AI_DAILY_BUDGET=800
